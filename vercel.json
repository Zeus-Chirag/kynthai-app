{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/reminders/schedule",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/chat/cleanup",
      "schedule": "30 3 * * *"
    }
  ]
}
