# ============================================================================
# Kyntha Environment Variables Configuration
# ============================================================================
# Copy this file to .env.local and fill in the values for your environment
# Never commit actual secrets to version control
# ============================================================================

# ────── Next.js Configuration ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kyntha-restored-7000-us.vercel.app
NODE_ENV=production

# ────── Database Configuration ─────────────────────────────────────────────
# PostgreSQL connection string (required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/kyntha
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30

# ────── Authentication (NextAuth + Supabase) ───────────────────────────────
NEXTAUTH_URL=https://kyntha-restored-7000-us.vercel.app
NEXTAUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ────── Encryption Keys ────────────────────────────────────────────────────
# Used for encrypting sensitive fields like SSN, phone, etc.
ENCRYPTION_KEY=your-32-character-hex-key-here
ENCRYPTION_IV=your-16-character-hex-iv-here

# ────── Payment Processing (Stripe) ────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PK=pk_live_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_ENDPOINT_SECRET=we_xxxxxxxxxxxxx

# ────── AI & LLM Configuration (OpenAI) ────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_ORGANIZATION_ID=org-xxxxxxxxxxxxx

# ────── SMS & Notifications (Twilio) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxx

# ────── Email Configuration ────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxx
SMTP_FROM_EMAIL=noreply@kyntha.app
SMTP_FROM_NAME=Kyntha Health

# ────── Rate Limiting (Upstash Redis) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-region-xxxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ────── Error Tracking (Sentry) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=kyntha-app
SENTRY_ENVIRONMENT=production

# ────── Analytics & Monitoring ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=xxxxxxxxxxxxx

# ────── Logging Configuration ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# ────── AWS S3 (Medical Documents Storage) ────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=kyntha-medical-documents
AWS_S3_ENCRYPTION_ENABLED=true

# ────── Feature Flags ──────────────────────────────────────────────────────
FEATURE_FLAG_VIDEO_CALLS=true
FEATURE_FLAG_AI_CHAT=true
FEATURE_FLAG_LAB_BOOKINGS=true
FEATURE_FLAG_FAMILY_SHARING=true
FEATURE_FLAG_PRESCRIPTION_INTELLIGENCE=true

# ────── Backup & Disaster Recovery ────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kyntha-backups

# ────── Security Configuration ────────────────────────────────────────────
CSRF_SECRET=your-csrf-secret-key
CORS_ALLOWED_ORIGINS=https://kyntha-restored-7000-us.vercel.app,https://app.kyntha.app
SECURE_COOKIES=true
SAMESITE_COOKIES=Strict
HTTPS_ONLY=true
HSTS_MAX_AGE=31536000

# ────── Compliance & Legal ────────────────────────────────────────────────
HIPAA_ENABLED=true
GDPR_ENABLED=true
CCPA_ENABLED=true
PII_RETENTION_DAYS=2555

# ────── Development-Only Variables ────────────────────────────────────────
DEBUG=false
VERBOSE_LOGGING=false
MOCK_PAYMENTS=false
MOCK_SMS=false
