# ============================================================================
# Kynthai Environment Variables — TEMPLATE
# ============================================================================
# Copy this file to `.env.production` (or `.env.local` for dev) and fill in
# real values. NEVER commit the populated file — `.env*` is gitignored.
#
# For Vercel:  Project → Settings → Environment Variables
# For GitHub Actions:  Settings → Secrets and variables → Actions
# For Docker:  pass via `--env-file .env.production` or compose `env_file:`
# ============================================================================

# ────── Next.js / App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kynthai.app
NODE_ENV=production

# ────── Database (Postgres / Supabase) ───────────────────────────────────────
# Direct connection — used by Prisma migrations and long-lived queries.
# For Supabase, append `?sslmode=require` and URL-encode any special chars
# in the password (e.g. `@` → `%40`).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# (Optional) pooler URL for serverless runtimes that need short-lived
# connections through PgBouncer.
# DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30

# ────── Authentication (NextAuth + Supabase) ───────────────────────────────
NEXTAUTH_URL=https://kynthai.app
NEXTAUTH_SECRET=                                  # openssl rand -hex 32
SUPABASE_JWT_SECRET=                              # Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # Supabase anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=                         # Supabase service_role / secret key (server-only!)
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ────── Field-level encryption (PHI at rest) ────────────────────────────────
# 32 bytes = 64 hex chars. 16 bytes IV = 32 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
ENCRYPTION_IV=

# ────── Sessions / internal tokens ──────────────────────────────────────────
SESSION_SECRET=                                    # openssl rand -hex 32
CRON_SECRET=                                       # openssl rand -hex 32
VIDEO_TOKEN_SECRET=                                # openssl rand -hex 32
CSRF_SECRET=                                       # openssl rand -hex 32

# ────── CORS / Cookies / TLS ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://kynthai.app,https://www.kynthai.app
CORS_ORIGIN=https://kynthai.app,https://www.kynthai.app
SECURE_COOKIES=true
SAMESITE_COOKIES=Strict
HTTPS_ONLY=true
HSTS_MAX_AGE=31536000

# ────── Feature flags ────────────────────────────────────────────────────────
FEATURE_FLAG_VIDEO_CALLS=true
FEATURE_FLAG_AI_CHAT=true
FEATURE_FLAG_LAB_BOOKINGS=true
FEATURE_FLAG_FAMILY_SHARING=true
FEATURE_FLAG_PRESCRIPTION_INTELLIGENCE=true
NEXT_PUBLIC_ENABLE_DEMO=false
NEXT_PUBLIC_COMPLIANCE_MODE=true
NEXT_PUBLIC_JURISDICTION=US

# ────── Compliance & Legal ───────────────────────────────────────────────────
HIPAA_ENABLED=true
GDPR_ENABLED=true
CCPA_ENABLED=true
PII_RETENTION_DAYS=2555

# ────── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90
DEBUG=false
VERBOSE_LOGGING=false

# ────── Payment (Stripe) ────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PK=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_ENDPOINT_SECRET=we_xxx

# ────── AI (OpenAI / compatible) ────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
OPENAI_ORGANIZATION_ID=org-xxx

# ────── SMS (Twilio) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=MGxxx

# ────── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kynthai.app
SMTP_FROM_NAME=Kynthai Health

# ────── Rate limiting (Upstash Redis) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ────── Error tracking (Sentry) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG=
SENTRY_PROJECT=kynthai-app
SENTRY_ENVIRONMENT=production

# ────── Analytics ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXX
NEXT_PUBLIC_MIXPANEL_TOKEN=

# ────── AWS S3 (medical documents) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=kynthai-medical-documents
AWS_S3_ENCRYPTION_ENABLED=true

# ────── Backup & disaster recovery ──────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=kynthai-backups

# ────── Dev-only ────────────────────────────────────────────────────────────
MOCK_PAYMENTS=false
MOCK_SMS=false
